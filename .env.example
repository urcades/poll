# Copy to .env (git-ignored) for local development; set as real environment
# variables or platform secrets in production.

# Lets the home page turn a typed description into a pre-filled poll, using
# TypeSafe's Jev model. Leave empty to turn that field off.
TYPESAFE_API_KEY=

# Optional: makes the holder admin of every poll and the only reader of the
# usage log at /events (see README).
# OPERATOR_TOKEN=

# Usage log (see README "Usage Log"): EVENT_LOG=off disables it,
# EVENT_RETENTION_DAYS=365 sets how long events are kept, EVENT_STDOUT=off
# stops the JSON line per event on stdout.
