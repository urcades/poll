# Copy to .env (git-ignored) for local development; set as real environment
# variables or platform secrets in production.

# Lets the home page turn a typed description into a pre-filled poll.
# Clef (Cloudflare Workers AI) is preferred; inside the Cloudflare Worker it
# needs nothing (the AI binding), elsewhere set both of these:
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Or TypeSafe's Jev, used when the Cloudflare settings are absent:
TYPESAFE_API_KEY=
# DESCRIBE_PROVIDER=clef   # or jev, to force one
# Leave all empty to turn the field off.

# Optional: makes the holder admin of every poll and the only reader of the
# usage log at /events (see README).
# OPERATOR_TOKEN=

# Usage log (see README "Usage Log"): EVENT_LOG=off disables it,
# EVENT_RETENTION_DAYS=365 sets how long events are kept, EVENT_STDOUT=off
# stops the JSON line per event on stdout.
